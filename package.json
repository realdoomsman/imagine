{
  "name": "imagine",
  "private": true,
  "version": "0.1.0",
  "description": "IMAGINE — lock-to-earn vaults for StonkFun coins, paid in each coin's pair asset",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "program:build": "anchor build",
    "program:test": "pnpm --filter @imagine/sdk test",
    "dev": "pnpm --parallel --filter @imagine/web --filter @imagine/api dev"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
