# Public build-time settings (bundled into the browser; never put secrets here)
NEXT_PUBLIC_API_URL=http://localhost:8080
# The site's RPC. Production: the API's proxy (https://api.imagine.fun/rpc), so
# the keyed provider URL never ships in the bundle. Local: the fork, directly.
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8999
# PubSub endpoint for confirmations; production wss://api.imagine.fun/rpc-ws.
# Unset: derived from NEXT_PUBLIC_RPC_URL the way web3.js does.
NEXT_PUBLIC_WS_URL=
# mainnet-beta hides the network notice; devnet shows "Devnet"; anything else shows "Local fork"
NEXT_PUBLIC_CLUSTER=localnet
# Google OAuth client id for "Sign in with Google" (optional)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# The official $IMAGINE mint; every official-coin surface stays hidden while empty
NEXT_PUBLIC_OFFICIAL_MINT=
# Social link; hidden while empty
NEXT_PUBLIC_X_URL=
