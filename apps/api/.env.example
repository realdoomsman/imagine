# IMAGINE API / indexer / keeper. Copy to .env.local and fill in.
#
# Local development runs against a mainnet fork (scripts/mainnet-fork.sh):
# StonkFun is mainnet-only, and the fork carries the real Raydium LaunchLab,
# CPMM and Token-2022 programs plus StonkFun's platform config at their
# mainnet addresses. The IMAGINE program (imaguT3XXBk1MuKQA6XCk1KJsGM2YgfM1tA4pQQ3spa)
# is deployed onto it like on mainnet.
DATABASE_URL=postgres://postgres@127.0.0.1:5432/imagine
# The keyed provider endpoint (e.g. Helius). It stays server-side: the site
# talks to it only through this API's /rpc and /rpc-ws proxy.
RPC_URL=http://127.0.0.1:8999
# PubSub endpoint; unset derives it from RPC_URL (ws(s)://, local port + 1).
RPC_WS_URL=
# JSON-RPC calls / websocket subscriptions per minute per client IP via the proxy (0 = no limit).
RPC_PROXY_LIMIT_PER_MIN=600
# localnet (the mainnet fork) or mainnet-beta
CLUSTER=localnet
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3010,http://localhost:3011
SITE_ORIGIN=http://localhost:3010
COOKIE_SECURE=0

# Public origin of this API. Coin metadata and images are served from it and
# their URIs are written on chain at launch: https://api.imagine.fun in production.
API_PUBLIC_ORIGIN=http://localhost:8080

# Lookup table for one-transaction launches (scripts/create-alt.ts prints it).
LAUNCH_ALT=

# Upstream APIs (defaults shown; JUPITER_API_KEY only with an api.jup.ag base).
STONKFUN_API=https://www.stonkfun.xyz
JUPITER_SWAP_URL=https://lite-api.jup.ag/swap/v1
JUPITER_PRICE_URL=https://lite-api.jup.ag/price/v3
JUPITER_API_KEY=

# Treasury for a new config (scripts/init-config.ts); defaults to the admin.
TREASURY_PUBKEY=

# Google sign-in with server-held wallets
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/google/callback
WALLET_MASTER_KEY=
SESSION_SECRET=

# Shared by the web server's renders and the API (exempts them from the rate limit)
IMAGINE_INTERNAL_KEY=

# Keeper: a JSON byte array or base58 secret (not the admin/deploy key)
KEEPER_KEYPAIR=
KEEPER_INTERVAL_MS=60000
# Sync a pool once its vault holds this many USD more than at its last sync.
SYNC_MIN_USD=1
