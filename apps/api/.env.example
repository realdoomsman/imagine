# VISE API / indexer / keeper. Copy to .env.local and fill in.
DATABASE_URL=postgres://postgres:password@127.0.0.1:5432/vise
RPC_URL=http://127.0.0.1:8899
RPC_WS_URL=
CLUSTER=localnet
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000
SITE_ORIGIN=http://localhost:3000
COOKIE_SECURE=0
TREASURY_PUBKEY=
LAUNCH_ALT=
SWEEP_MIN_LAMPORTS=

# Google sign-in with server-held wallets
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/google/callback
WALLET_MASTER_KEY=
SESSION_SECRET=

# Internal endpoints shared by api and indexer
VISE_INTERNAL_KEY=

# Keeper
KEEPER_KEYPAIR=path/to/keeper-keypair.json
KEEPER_INTERVAL_MS=
